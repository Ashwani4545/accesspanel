# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/login-system
# Atlas:  mongodb+srv://<user>:<password>@<cluster-url>/login-system?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/login-system

# Server port
PORT=5000

# JWT secrets - use long, random strings in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret

# Token lifetimes
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Comma-separated list of allowed frontend origins (for CORS)
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
